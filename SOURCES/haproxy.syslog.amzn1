$ModLoad imudp
$UDPServerAddress 127.0.0.1
$UDPServerRun 514
$MaxMessageSize 64k
$FileCreateMode 0600

$template HAProxy,"%TIMESTAMP% %syslogseverity-text:::UPPERCASE%: %msg%\n"
$template HAProxyAccess,"%msg%\n"

local0.=info     /var/log/haproxy/access.log;HAProxyAccess
local0.=notice;local0.=warning    /var/log/haproxy/status.log;HAProxy
local0.error    /var/log/haproxy/error.log;HAProxy
local0.* ~
